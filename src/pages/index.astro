---
import { ArrowRight, CheckCircle2 } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import CustomerCard from '../components/CustomerCard.astro';
import LogoCloud from '../components/LogoCloud.astro';
import ProductMockup from '../components/ProductMockup.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { industries, platformModules, siteConfig, valueCards } from '../data/site';

const customerStories = (await getCollection('customers'))
	.filter((story) => story.id.startsWith('en/'))
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
	.slice(0, 3);
---

<BaseLayout
	title="AI-native Customer Intelligence Platform for Consumer Brands"
	description="Unify customer data, uncover real-time insights, and automate personalized marketing, loyalty, and growth across every channel."
>
	<section class="navy-grid overflow-hidden py-12 text-white md:py-20">
		<div class="container-page grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:items-center">
			<div>
				<p class="inline-flex rounded-full border border-white/16 bg-white/10 px-4 py-2 text-xs font-bold text-[var(--color-lime)]">
					AI-native Customer Intelligence
				</p>
				<h1 class="mt-5 text-[clamp(1.9rem,7.5vw,3rem)] font-black leading-[1.04] tracking-[0] lg:text-5xl">
					Customer<br />
					Intelligence<br />
					<span class="whitespace-nowrap">for <span class="inline-block text-[var(--color-lime)] will-change-transform" data-growth-word>Revenue</span> Growth.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-base leading-7 text-white/72 md:text-lg">
					Unify every customer.<br />
					Activate every insight.<br />
					Automate every moment of growth.
				</p>
				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<a
						class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-md bg-[var(--color-green)] px-5 text-sm font-bold text-white transition hover:bg-[var(--color-green-dark)] sm:w-fit"
						href={siteConfig.cta.href}
					>
						{siteConfig.cta.label}
						<ArrowRight class="size-4" />
					</a>
				</div>
				<ul class="mt-7 grid gap-3 text-sm text-white/72 sm:grid-cols-3">
					<li class="flex items-center gap-2"><CheckCircle2 class="size-4 text-[var(--color-lime)]" /> Real-time CDP</li>
					<li class="flex items-center gap-2"><CheckCircle2 class="size-4 text-[var(--color-lime)]" /> Loyalty AI</li>
					<li class="flex items-center gap-2"><CheckCircle2 class="size-4 text-[var(--color-lime)]" /> Marketing automation</li>
				</ul>
			</div>
			<div class="lg:max-w-[620px] lg:justify-self-end xl:max-w-[660px]">
				<ProductMockup />
			</div>
		</div>
	</section>

	<LogoCloud />

	<section class="bg-[var(--color-soft)] py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Why Socialhub.AI"
				title="From scattered customer data to decisions teams can act on."
				description="The platform is structured around the workflows consumer brands repeat every week: understand the customer, find the opportunity, and activate the next journey."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				{
					valueCards.map((card) => (
						<div class="surface-card rounded-lg p-6">
							<p class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">{card.kicker}</p>
							<h2 class="mt-4 text-xl font-bold tracking-[0]">{card.title}</h2>
							<p class="mt-4 text-sm leading-6 text-[var(--color-muted)]">{card.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-white py-16">
		<div class="container-page">
			<div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
				<SectionHeading
					kicker="Platform"
					title="One intelligence layer for data, loyalty, marketing, and AI."
					description="Keep the website maintainable by treating each capability as a reusable platform module. The same content can power homepage cards, product pages, and related CTAs."
				/>
				<div class="grid gap-4 sm:grid-cols-2">
					{
						platformModules.map((module) => (
							<a class="surface-card rounded-lg p-5 transition hover:-translate-y-1 hover:border-[var(--color-green)]" href={module.href}>
								<span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">{module.tag}</span>
								<h2 class="mt-4 text-xl font-bold tracking-[0]">{module.title}</h2>
								<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{module.description}</p>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="bg-[var(--color-soft)] py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Built around consumer brand operating models."
				description="Start with the strongest verticals, then add more industry pages through CMS content as the story and evidence base grows."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
				{
					industries.map((industry) => (
						<a class="surface-card rounded-lg p-5 transition hover:-translate-y-1 hover:border-[var(--color-green)]" href={industry.href}>
							<h2 class="text-lg font-bold tracking-[0]">{industry.title}</h2>
							<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{industry.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-white py-16">
		<div class="container-page">
			<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
				<SectionHeading
					kicker="Customers"
					title="Customer stories that adapt to the fields you fill."
					description="Each story can show metrics, products used, challenge, solution, testimonial, and related content only when those fields exist."
				/>
				<a class="inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]" href="/customers/">
					View all stories
					<ArrowRight class="size-4" />
				</a>
			</div>
			<div class="mt-10 grid gap-5 lg:grid-cols-3">
				{customerStories.map((story) => <CustomerCard story={story} />)}
			</div>
		</div>
	</section>

	<CTASection />
</BaseLayout>

<script is:inline>
	const growthWords = ['Revenue', 'Repurchase', 'Loyalty', 'Brand', 'Customer'];
	const growthWord = document.querySelector('[data-growth-word]');
	let growthWordIndex = 0;

	if (growthWord) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		window.setInterval(async () => {
			growthWordIndex = (growthWordIndex + 1) % growthWords.length;

			if (reduceMotion) {
				growthWord.textContent = growthWords[growthWordIndex];
				return;
			}

			await growthWord.animate(
				[
					{ opacity: 1, transform: 'translateY(0) scale(1)', filter: 'blur(0)' },
					{ opacity: 0, transform: 'translateY(-0.35em) scale(0.98)', filter: 'blur(6px)' },
				],
				{ duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
			).finished;

			growthWord.textContent = growthWords[growthWordIndex];
			growthWord.animate(
				[
					{ opacity: 0, transform: 'translateY(0.35em) scale(0.98)', filter: 'blur(6px)' },
					{ opacity: 1, transform: 'translateY(0) scale(1)', filter: 'blur(0)' },
				],
				{ duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
			);
		}, 2400);
	}
</script>
