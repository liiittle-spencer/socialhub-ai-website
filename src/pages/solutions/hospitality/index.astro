---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Hospitality" description="Customer intelligence for hospitality brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Customer intelligence for hospitality."
				description="Unify guest profiles, visit behavior, service interactions, offers, and loyalty engagement across properties, channels, and markets."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Guest identity and preference</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Understand guests across booking, service, visit, campaign, and loyalty signals.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Localized loyalty programs</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Support multiple brands, regions, and differentiated loyalty programs under one operational model.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
