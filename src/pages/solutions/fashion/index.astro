---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Fashion & Apparel" description="Customer intelligence for fashion and apparel brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Customer intelligence for fashion and apparel."
				description="Connect loyalty programs, campaign operations, multichannel customer data, and 360 personas for brands with complex store and digital journeys."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Flexible loyalty operations</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Support customized bonus rules, member programs, campaign management, and cross-channel engagement.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Unified customer analysis</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Bring fragmented store, web, social, campaign, and service signals into a single customer view.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
