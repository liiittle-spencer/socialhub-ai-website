import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Food & Beverage" description="Customer intelligence for food and beverage brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Customer intelligence for food and beverage."
				description="Use ordering, visit, loyalty, and campaign signals to improve repeat visits and personalized engagement."
			/>
		</div>
	</section>
	<CTASection />
</BaseLayout>
