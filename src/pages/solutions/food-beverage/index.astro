---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Food & Beverage" description="Customer intelligence for food and beverage brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Customer intelligence for food and beverage."
				description="Unify ordering, WhatsApp service, membership signup, offers, and omnichannel experience orchestration for restaurant brands."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Smart front desk</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Guide customers through membership, ordering, and offers from channels such as WhatsApp.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Integrated operations</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Reduce manual work by connecting customer service, marketing, and member operations in one workflow.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Standardized experience</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Keep customer journeys consistent across online ordering, store visits, campaigns, and service channels.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
