---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Supermarket & Grocery" description="Customer intelligence for supermarket and grocery brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Solutions"
				title="Customer intelligence for supermarket and grocery."
				description="Handle complex product master data, high-concurrency transactions, massive price and point calculations, and CRM+APP migration."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Complex product data</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Manage large SKU catalogs, attributes, bundles, pricing rules, and customer personalization logic.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">High concurrency</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Support peak transaction volume with real-time data processing and scalable customer operations.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Seamless migration</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Move CRM and loyalty operations from legacy systems into a unified, customer-aware platform.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
