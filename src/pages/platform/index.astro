---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import ProductMockup from '../../components/ProductMockup.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { platformModules } from '../../data/site';
---

<BaseLayout title="Platform" description="Socialhub.AI platform overview for customer intelligence, CDP, loyalty, marketing automation, and AI analytics.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
			<SectionHeading
				kicker="Platform"
				title="Multi-agent AI for the full customer lifecycle."
				description="Socialhub.AI brings unified data, business intelligence, marketing workflow, and loyalty decisioning into one AI-native Customer Intelligence Platform."
			/>
			<ProductMockup />
		</div>
	</section>
	<section class="bg-white py-16">
		<div class="container-page grid gap-5 md:grid-cols-3">
			<div class="surface-card rounded-lg p-6">
				<p class="text-3xl font-black text-[var(--color-navy)]">50+</p>
				<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">enterprise system and channel integrations across commerce, CRM, loyalty, service, and social workflows.</p>
			</div>
			<div class="surface-card rounded-lg p-6">
				<p class="text-3xl font-black text-[var(--color-navy)]">100+</p>
				<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">brands served across retail, sportswear, beauty, F&B, electronics, luxury, and loyalty ecosystems.</p>
			</div>
			<div class="surface-card rounded-lg p-6">
				<p class="text-3xl font-black text-[var(--color-navy)]">25</p>
				<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">countries supported with global operations, data compliance, and multi-region loyalty programs.</p>
			</div>
		</div>
	</section>
	<section class="bg-white py-20">
		<div class="container-page grid gap-5 md:grid-cols-2">
			{
				platformModules.map((module) => (
					<a class="surface-card rounded-lg p-6 transition hover:-translate-y-1 hover:border-[var(--color-green)]" href={module.href}>
						<span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">{module.tag}</span>
						<h2 class="mt-5 text-2xl font-bold tracking-[0]">{module.title}</h2>
						<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">{module.description}</p>
						<span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]">
							Learn more
							<ArrowRight class="size-4" />
						</span>
					</a>
				))
			}
		</div>
	</section>
	<CTASection />
</BaseLayout>
