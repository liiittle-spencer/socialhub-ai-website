---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="Hyper-personalized Loyalty" description="AI-driven loyalty intelligence and member engagement workflows for consumer brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Platform"
				title="Every touchpoint drives measurable member value."
				description="Move beyond points and tiers. Understand every member, predict the next best action, and trigger loyalty responses in real time."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Member intelligence</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Analyze value, lifecycle stage, preference, visit patterns, and churn signals across every member profile.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Adaptive journeys</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Adjust customer journeys when behavior changes and orchestrate the next best loyalty action automatically.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
