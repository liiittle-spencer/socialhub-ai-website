---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="AI Data Scientist" description="AI-ready data and business intelligence for consumer brands.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Platform"
				title="AI-Ready Customer Data And Business Intelligence"
				description="Unify fragmented customer profiles, behavioral events, and business KPIs into a semantic layer that AI can interpret, explain, and activate."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Unified customer profiles</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Reconcile identities across POS, ecommerce, CRM, apps, loyalty, service, and third-party platforms.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Real-time event stack</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Capture web, app, store, service, and campaign signals as they happen, then turn them into segments and triggers.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Semantic KPI model</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Standardize revenue, conversion, churn, retention, CAC, LTV, and AOV definitions across teams.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">AI-generated insights</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Explain what is changing, why it is changing, and which customer actions should happen next.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
