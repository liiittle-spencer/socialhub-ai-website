---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
---

<BaseLayout title="AI Marketing Master" description="AI-assisted marketing automation for personalized customer journeys.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Platform"
				title="Accelerate growth with intelligent marketing."
				description="Turn campaign objectives into audiences, marketing canvases, content templates, and automated workflows that teams can review and launch."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Targeted campaigns</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Segment audiences from customer intelligence and activate personalized campaigns across lifecycle moments.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Workflow automation</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Automate repetitive campaign tasks while keeping humans in control of goals, approvals, and refinement.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<h2 class="text-xl font-bold tracking-[0]">Content assistance</h2>
					<p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">Generate campaign templates, promotion logic, and action recommendations from customer and business signals.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
