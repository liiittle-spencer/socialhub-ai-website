---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import ProductSubnav from '../../../components/ProductSubnav.astro';
import ProductVisual from '../../../components/ProductVisual.astro';
import ProofBar from '../../../components/ProofBar.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { businessLoop, businessOutcomes, productRoles } from '../../../data/products';
---

<BaseLayout
	title="Socialhub.AI"
	description="Socialhub.AI turns customer signals into repeat revenue through Real-Time CDP, Loyalty CRM, and Marketing Automation."
	canonical="/product/socialhub-ai/"
>
	<ProductSubnav />
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
			<div>
				<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">Socialhub.AI Platform</p>
				<h1 class="mt-4 text-balance text-[clamp(2rem,6vw,3.5rem)] font-black leading-[1.06] tracking-[0] text-[var(--color-navy)]">
					Turn customer signals into repeat revenue.
				</h1>
				<p class="mt-5 max-w-2xl text-lg leading-8 text-[#344054]">
					Socialhub.AI connects Real-Time CDP, Loyalty CRM, and Marketing Automation into one operating loop for consumer brands.
				</p>
				<p class="mt-4 max-w-2xl text-base leading-7 text-[#344054]">
					When a customer signal appears, the platform helps your team know who it is, decide what should happen next, and learn whether it worked.
				</p>
				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<a class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[var(--color-green)] px-5 text-sm font-bold text-white" href="/contact/">
						Book a Demo
						<ArrowRight class="size-4" />
					</a>
					<a class="inline-flex h-11 items-center justify-center rounded-md border border-[var(--color-border)] bg-white px-5 text-sm font-bold text-[var(--color-navy)]" href="#loop">
						See the Loop
					</a>
				</div>
			</div>
			<ProductVisual title="From First Signal To Next Purchase" description="The platform is designed around the commercial path from unknown behavior to repeat customer value." />
		</div>
	</section>

	<section id="loop" class="bg-white py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Business Loop"
				title="The Customer Journey Becomes Operable"
				description="The point is not to store more data. The point is to move a customer from first signal to the next measurable action."
			/>
			<div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{businessLoop.map((item) => (
					<div class="surface-card rounded-lg p-5">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">{item.step}</p>
						<h3 class="mt-3 text-xl font-bold tracking-[0] text-[var(--color-navy)]">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-[#344054]">{item.description}</p>
						<p class="mt-4 text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-muted)]">{item.product}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-[var(--color-soft)] py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Product Roles"
				title="Three Products. One Customer Growth Loop"
				description="Each product owns a clear part of the journey, then passes the customer context forward."
			/>
			<div class="mt-10 grid gap-5 lg:grid-cols-3">
				{productRoles.map((product) => (
					<a class="surface-card rounded-lg p-6 transition hover:-translate-y-1 hover:border-[var(--color-green)]" href={product.href}>
						<h3 class="text-2xl font-bold tracking-[0] text-[var(--color-navy)]">{product.title}</h3>
						<p class="mt-3 text-lg font-bold leading-7 text-[#344054]">{product.role}</p>
						<p class="mt-3 text-sm leading-6 text-[#344054]">{product.description}</p>
						<span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]">
							Explore {product.title}
							<ArrowRight class="size-4" />
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="bg-white py-16">
		<div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
			<SectionHeading
				kicker="AI Native"
				title="Shorten The Path From Signal To Action"
				description="AI is useful only when it helps teams decide what to do next, who should receive it, and how to measure whether it worked."
			/>
			<div class="grid gap-4 md:grid-cols-3">
				{['Find the next audience before the team opens a spreadsheet.', 'Recommend the next action based on value, intent, and timing.', 'Learn from every click, purchase, redemption, and visit.'].map((item) => (
					<div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-soft)] p-5">
						<p class="text-sm font-semibold leading-6 text-[#344054]">{item}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-[var(--color-soft)] py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Business Outcomes"
				title="Growth Depends On What Happens After Acquisition"
				description="The platform is built for teams that need repeat purchase, member value, campaign speed, and promotion ROI to move together."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				{businessOutcomes.map((outcome) => (
					<div class="surface-card rounded-lg p-6">
						<h3 class="text-xl font-bold tracking-[0] text-[var(--color-navy)]">{outcome.title}</h3>
						<p class="mt-3 text-sm leading-6 text-[#344054]">{outcome.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<ProofBar />
	<CTASection
		title="Bring One Customer Growth Moment"
		description="We will show how Socialhub.AI turns that signal into a profile, member action, automated journey, and measurable result."
	/>
</BaseLayout>
