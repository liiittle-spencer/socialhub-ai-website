---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { productLines } from '../../data/products';
---

<BaseLayout title="Products" description="Explore Socialhub.AI for real-time customer intelligence and MarPro for business expertise from day one." canonical="/product/">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
			<div>
				<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">Products</p>
				<h1 class="mt-4 text-balance text-[clamp(2rem,6vw,3.5rem)] font-black leading-[1.06] tracking-[0] text-[var(--color-navy)]">
					Build the path from customer signal to repeat revenue.
				</h1>
				<p class="mt-5 max-w-2xl text-lg leading-8 text-[#344054]">
					Socialhub.AI is the core platform for customer data, loyalty, and marketing automation. MarPro is reserved for business expertise and execution guidance.
				</p>
				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<a class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[var(--color-green)] px-5 text-sm font-bold text-white" href="/product/socialhub-ai/">
						Explore Socialhub.AI
						<ArrowRight class="size-4" />
					</a>
					<a class="inline-flex h-11 items-center justify-center rounded-md border border-[var(--color-border)] bg-white px-5 text-sm font-bold text-[var(--color-navy)]" href="/product/marpro/">
						View MarPro
					</a>
				</div>
			</div>
			<ProductVisual title="Customer Growth Loop" description="The product family is organized around the moments that move a customer from first signal to repeat revenue." />
		</div>
	</section>

	<section class="bg-white py-16">
		<div class="container-page">
			<SectionHeading
				kicker="Product Family"
				title="Start With The Platform Behind The Growth Loop"
				description="Keep the first choice simple: Socialhub.AI for customer intelligence and activation, MarPro for business expertise as the product narrative matures."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				{productLines.map((product) => (
					<a class="surface-card rounded-lg p-6 transition hover:-translate-y-1 hover:border-[var(--color-green)]" href={product.href}>
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">{product.label}</p>
						<h2 class="mt-4 text-2xl font-bold tracking-[0] text-[var(--color-navy)]">{product.name}</h2>
						<p class="mt-3 text-base leading-7 text-[#344054]">{product.description}</p>
						<div class="mt-5 flex flex-wrap gap-2">
							{product.tags.slice(0, product.primary ? 4 : 3).map((tag) => <span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">{tag}</span>)}
						</div>
						<span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]">
							View product
							<ArrowRight class="size-4" />
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<CTASection
		title="Review The Socialhub.AI Platform First"
		description="The next page explains how Real-Time CDP, Loyalty CRM, and Marketing Automation work together as one customer growth loop."
	/>
</BaseLayout>
