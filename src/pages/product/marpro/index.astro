---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
---

<BaseLayout title="MarPro" description="MarPro helps teams become business experts from day one with structured guidance and execution support." canonical="/product/marpro/">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
			<div>
				<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">Product / MarPro</p>
				<p class="mt-4 text-sm font-bold text-[var(--color-green-dark)]">Be a Business Expert in Day-One</p>
				<h1 class="mt-4 text-balance text-4xl font-black leading-tight tracking-[0] text-[var(--color-navy)] md:text-6xl">
					Start with Business Expertise from Day One
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-muted)]">
					MarPro is designed to help teams move from business questions to structured recommendations and execution guidance faster. Full product details are coming soon.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-[var(--color-green)] px-6 text-sm font-bold text-white" href="/contact/">
						Talk to a Product Expert
						<ArrowRight class="size-4" />
					</a>
					<a class="inline-flex h-12 items-center justify-center rounded-lg border border-[var(--color-border)] bg-white px-6 text-sm font-bold text-[var(--color-navy)]" href="/product/socialhub-ai/">
						Explore Socialhub.AI
					</a>
				</div>
			</div>
			<div class="surface-card rounded-lg p-6">
				<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">Reserved product route</p>
				<h2 class="mt-3 text-2xl font-black tracking-[0] text-[var(--color-navy)]">MarPro Product Content Is Being Finalized</h2>
				<p class="mt-4 text-sm leading-6 text-[var(--color-muted)]">
					This page keeps the product architecture complete while positioning, features, use cases, and proof points are reviewed.
				</p>
			</div>
		</div>
	</section>
	<CTASection title="Need Business Expertise And Execution Guidance?" description="Talk to a product expert while the full MarPro product narrative is being finalized." />
</BaseLayout>
