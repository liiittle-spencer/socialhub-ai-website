---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="About" description="About Socialhub.AI.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Company"
				title="Building customer intelligence infrastructure for consumer brands."
				description="This page is ready for company story, leadership, offices, events, and hiring content once those inputs are available."
			/>
		</div>
	</section>
	<CTASection />
</BaseLayout>
