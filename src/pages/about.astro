---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="About" description="About Socialhub.AI.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Company"
				title="AI-native intelligence for customer-driven enterprises."
				description="Socialhub.AI helps enterprises unify data, multi-agent intelligence, and workflow execution so teams can transform fragmented customer signals into real-time decisions and actions."
			/>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				<div class="surface-card rounded-lg p-6">
					<p class="text-3xl font-black text-[var(--color-navy)]">25+</p>
					<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">years of enterprise software, AI, cloud architecture, and global digital transformation experience across the founding team.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<p class="text-3xl font-black text-[var(--color-navy)]">100+</p>
					<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">brands supported across retail, sportswear, beauty, F&B, electronics, luxury, and loyalty ecosystems.</p>
				</div>
				<div class="surface-card rounded-lg p-6">
					<p class="text-3xl font-black text-[var(--color-navy)]">SOC 2</p>
					<p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">security and compliance posture aligned with global enterprise requirements, including GDPR and ISO references.</p>
				</div>
			</div>
		</div>
	</section>
	<CTASection />
</BaseLayout>
