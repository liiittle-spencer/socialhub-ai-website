---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import SectionHeading from '../../components/SectionHeading.astro';
---

<BaseLayout title="Socialhub.AI 中文站" description="Socialhub.AI Chinese content placeholder.">
	<section class="bg-[var(--color-soft)] py-20">
		<div class="container-page">
			<SectionHeading
				kicker="Multilingual Ready"
				title="Chinese content structure is reserved."
				description="The first release is English. Chinese routing and content directories are reserved so localization can be added without changing the core architecture."
			/>
		</div>
	</section>
	<CTASection />
</BaseLayout>
