---
import { proofLogos } from '../data/site';

const logoLoop = [...proofLogos, ...proofLogos];
const logoVars = (logo: (typeof proofLogos)[number]) =>
	'src' in logo && logo.src
		? `--logo-height: ${logo.height ?? 42}px; --logo-max-width: ${logo.maxWidth ?? 168}px;`
		: undefined;
---

<section class="border-y border-[var(--color-border)] bg-white py-8">
	<div>
		<p class="text-center text-sm font-semibold text-[var(--color-muted)]">
			Serving consumer brands across retail, F&B, grocery, apparel, and lifestyle
		</p>
		<div class="logo-marquee mt-6" aria-label="Socialhub.AI customer brand logos">
			<div class="logo-marquee-track">
			{
				logoLoop.map((logo, index) => (
					<div
						class="logo-marquee-card"
						style={logoVars(logo)}
						aria-hidden={index >= proofLogos.length ? 'true' : undefined}
					>
						{
							'src' in logo && logo.src ? (
								<img class="logo-marquee-img" src={logo.src} alt={logo.label} loading="lazy" />
							) : (
								<span>{logo.label}</span>
							)
						}
					</div>
				))
			}
			</div>
		</div>
	</div>
</section>
