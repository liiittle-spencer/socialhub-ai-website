---
import { industrySolutions } from '../data/products';
import { proofLogos } from '../data/site';

type Props = {
	industry: keyof typeof industrySolutions;
};

const { industry } = Astro.props;
const solution = industrySolutions[industry];
const brandLogos = solution.brands
	.map((brand) => proofLogos.find((logo) => logo.label.toLowerCase() === brand.toLowerCase()))
	.filter(Boolean) as typeof proofLogos;
const logoLoop = [...brandLogos, ...brandLogos];
const logoVars = (logo: (typeof proofLogos)[number]) =>
	'src' in logo && logo.src ? `--logo-height: ${logo.height ?? 42}px; --logo-max-width: ${logo.maxWidth ?? 168}px;` : undefined;
---

<section class="bg-[var(--color-soft)] py-14">
	<div class="container-page">
		<div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
			<div>
				<p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">Related customer work</p>
				<h2 class="mt-3 text-2xl font-bold tracking-[0] text-[var(--color-navy)] md:text-3xl">Common patterns we support in this industry.</h2>
				<p class="mt-4 text-base leading-7 text-[var(--color-muted)]">
					These examples are distilled from customer programs and sales materials into reusable patterns for the public website.
				</p>
			</div>
			<div class="surface-card rounded-lg p-5">
				{brandLogos.length > 1 ? (
					<div class="logo-marquee" aria-label="Related customer brands">
						<div class="logo-marquee-track">
							{logoLoop.map((logo, index) => (
								<div class="logo-marquee-card" style={logoVars(logo)} aria-hidden={index >= brandLogos.length ? 'true' : undefined}>
									{'src' in logo && logo.src ? <img class="logo-marquee-img" src={logo.src} alt={logo.label} loading="lazy" /> : <span>{logo.label}</span>}
								</div>
							))}
						</div>
					</div>
				) : (
					<div class="grid gap-3">
						{solution.brands.map((brand) => (
							<div class="rounded-md border border-[var(--color-border)] bg-white p-4 text-sm font-bold text-[var(--color-navy)]">{brand}</div>
						))}
					</div>
				)}
			</div>
		</div>
		<div class="mt-8 grid gap-4 md:grid-cols-2">
			{solution.commonWork.map((item) => (
				<div class="rounded-lg border border-[var(--color-border)] bg-white p-5">
					<p class="text-sm leading-6 text-[#344054]">{item}</p>
				</div>
			))}
		</div>
	</div>
</section>
