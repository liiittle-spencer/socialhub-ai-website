---
import { Send } from '@lucide/astro';
import { siteConfig } from '../data/site';
---

<form
	class="surface-card grid gap-5 rounded-lg p-6"
	action={siteConfig.contact.formAction}
	method="post"
	enctype="text/plain"
>
	<input type="hidden" name="recipient" value={siteConfig.contact.emailTo} />
	<div>
		<label class="label" for="company-name">Company Name</label>
		<input class="field" id="company-name" name="Company Name" autocomplete="organization" required />
	</div>
	<div>
		<label class="label" for="contact-name">Contact Name</label>
		<input class="field" id="contact-name" name="Contact Name" autocomplete="name" required />
	</div>
	<div class="grid gap-5 md:grid-cols-2">
		<div>
			<label class="label" for="email-address">Email Address</label>
			<input class="field" id="email-address" name="Email Address" type="email" autocomplete="email" required />
		</div>
		<div>
			<label class="label" for="phone">Phone</label>
			<input class="field" id="phone" name="Phone" type="tel" autocomplete="tel" required />
		</div>
	</div>
	<div>
		<label class="label" for="message">Message</label>
		<textarea class="field min-h-34 resize-y" id="message" name="Message" required></textarea>
	</div>
	<button
		class="inline-flex w-fit items-center gap-2 rounded-md bg-[var(--color-green)] px-5 py-3 text-sm font-bold text-white transition hover:bg-[var(--color-green-dark)]"
		type="submit"
	>
		Submit request
		<Send class="size-4" />
	</button>
</form>
