---
import { footerGroups, siteConfig } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-navy)] text-white">
	<div class="container-page grid gap-10 py-12 lg:grid-cols-[1.2fr_2fr] lg:py-14">
		<div>
			<a href="/" class="flex items-center" aria-label="Socialhub.AI home">
				<img class="h-8 w-auto" src="/assets/logo-dark.svg" alt={siteConfig.name} width="250" height="48" />
			</a>
			<p class="mt-5 max-w-sm text-sm leading-6 text-white/68">
				AI-native customer intelligence platform for consumer brands.
			</p>
			<a class="mt-5 inline-flex text-sm font-semibold text-[var(--color-lime)]" href={`mailto:${siteConfig.email}`}>
				{siteConfig.email}
			</a>
		</div>
		<div class="grid gap-8 sm:grid-cols-3">
			{
				footerGroups.map((group) => (
					<div>
						<h2 class="text-sm font-bold text-white">{group.title}</h2>
						<ul class="mt-4 space-y-3 text-sm text-white/68">
							{group.links.map((link) => (
								<li>
									<a class="transition hover:text-white" href={link.href}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
	<div class="container-page flex flex-col gap-3 border-t border-white/12 py-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between">
		<p>© {year} Socialhub.AI. All rights reserved.</p>
		<div class="flex gap-5">
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
		</div>
	</div>
</footer>
