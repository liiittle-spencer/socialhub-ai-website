---
type Props = {
	kicker?: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
};

const { kicker, title, description, align = 'left' } = Astro.props;
---

<div class={align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl'}>
	{kicker && <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-green-dark)]">{kicker}</p>}
	<h2 class="mt-3 text-balance text-2xl font-bold tracking-[0] text-[var(--color-ink)] md:text-4xl">{title}</h2>
	{description && <p class="mt-4 text-base leading-7 text-[var(--color-muted)]">{description}</p>}
</div>
