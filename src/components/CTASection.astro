---
import { ArrowRight } from '@lucide/astro';
import { siteConfig } from '../data/site';

type Props = {
	title?: string;
	description?: string;
};

const {
	title = 'Know every customer. Act on every insight.',
	description = 'Turn customer data into real-time decisions, personalized journeys, and measurable growth.',
} = Astro.props;
---

<section class="bg-[var(--color-navy)] py-20 text-white">
	<div class="container-page grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
		<div>
			<p class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-lime)]">Ready when you are</p>
			<h2 class="mt-3 max-w-3xl text-balance text-3xl font-bold tracking-[0] md:text-5xl">{title}</h2>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-white/68">{description}</p>
		</div>
		<a
			class="inline-flex w-fit items-center gap-2 rounded-md bg-[var(--color-green)] px-5 py-3 text-sm font-bold text-white transition hover:bg-[var(--color-green-dark)]"
			href={siteConfig.cta.href}
		>
			{siteConfig.cta.label}
			<ArrowRight class="size-4" />
		</a>
	</div>
</section>
