---
import { ArrowRight } from '@lucide/astro';
import { contentSlug } from '../data/routing';

type Props = {
	post: {
		id: string;
		data: {
			title: string;
			description: string;
			publishDate: Date;
			category: string;
			tags?: string[];
		};
	};
};

const { post } = Astro.props;
const slug = contentSlug(post.id);
const date = post.data.publishDate.toLocaleDateString('en', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
---

<article class="surface-card flex h-full flex-col rounded-lg p-5 sm:p-6">
	<div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-green-dark)]">
		<span>{post.data.category}</span>
		<span class="text-[var(--color-border)]">/</span>
		<time datetime={post.data.publishDate.toISOString()}>{date}</time>
	</div>
	<h2 class="mt-4 text-lg font-bold tracking-[0] text-[var(--color-ink)]">{post.data.title}</h2>
	<p class="mt-3 flex-1 text-sm leading-6 text-[var(--color-muted)]">{post.data.description}</p>
	<a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]" href={`/blog/${slug}/`}>
		Read article
		<ArrowRight class="size-4" />
	</a>
</article>
