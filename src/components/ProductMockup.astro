---
import { Bot, ChartNoAxesCombined, Database, Sparkles } from '@lucide/astro';
---

<div class="mockup-grid relative overflow-hidden rounded-lg border border-white/14 bg-white/8 p-4 shadow-[var(--shadow-soft)]">
	<div class="rounded-lg border border-white/14 bg-[var(--color-navy)] p-4">
		<div class="flex items-center justify-between border-b border-white/10 pb-4">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-lime)]">Command Center</p>
				<h2 class="mt-2 text-xl font-bold text-white">Customer Intelligence</h2>
			</div>
			<div class="rounded-md bg-white/10 px-3 py-2 text-xs font-semibold text-white">Live</div>
		</div>

		<div class="mt-5 grid gap-4 lg:grid-cols-[0.95fr_1.05fr]">
			<section class="rounded-md border border-white/10 bg-white p-4 text-[var(--color-ink)]">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-green-dark)]">Customer 360</p>
						<h3 class="mt-2 text-lg font-bold">High-value members</h3>
					</div>
					<Database class="size-5 text-[var(--color-green)]" />
				</div>
				<div class="mt-5 space-y-3">
					<div class="h-3 w-full rounded-full bg-[#eef4f1]">
						<div class="h-3 w-[76%] rounded-full bg-[var(--color-green)]"></div>
					</div>
					<div class="grid grid-cols-3 gap-3 text-center">
						<div class="rounded-md bg-[var(--color-soft)] p-3">
							<p class="text-lg font-bold">42K</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">Members</p>
						</div>
						<div class="rounded-md bg-[var(--color-soft)] p-3">
							<p class="text-lg font-bold">18%</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">At risk</p>
						</div>
						<div class="rounded-md bg-[var(--color-soft)] p-3">
							<p class="text-lg font-bold">3.4x</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">LTV</p>
						</div>
					</div>
				</div>
			</section>

			<section class="rounded-md border border-white/10 bg-white p-4 text-[var(--color-ink)]">
				<div class="flex items-center gap-3">
					<span class="grid size-9 place-items-center rounded-md bg-[var(--color-mint)]">
						<Sparkles class="size-5 text-[var(--color-green-dark)]" />
					</span>
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-green-dark)]">AI insight</p>
						<h3 class="font-bold">Next-best action</h3>
					</div>
				</div>
				<p class="mt-4 text-sm leading-6 text-[var(--color-muted)]">
					Weekend buyers with declining visits respond best to tier upgrade reminders and local inventory prompts.
				</p>
				<div class="mt-4 flex flex-wrap gap-2">
					<span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">Loyalty</span>
					<span class="rounded-full bg-[#f2f4f7] px-3 py-1 text-xs font-bold text-[#475467]">Campaign</span>
					<span class="rounded-full bg-[#f2f4f7] px-3 py-1 text-xs font-bold text-[#475467]">Segment</span>
				</div>
			</section>
		</div>

		<div class="mt-4 grid gap-4 md:grid-cols-3">
			<div class="rounded-md border border-white/10 bg-white/10 p-4 text-white">
				<ChartNoAxesCombined class="size-5 text-[var(--color-lime)]" />
				<p class="mt-3 text-2xl font-bold">+24%</p>
				<p class="mt-1 text-sm text-white/65">Campaign conversion</p>
			</div>
			<div class="rounded-md border border-white/10 bg-white/10 p-4 text-white">
				<Bot class="size-5 text-[var(--color-lime)]" />
				<p class="mt-3 text-2xl font-bold">6</p>
				<p class="mt-1 text-sm text-white/65">AI agents active</p>
			</div>
			<div class="rounded-md border border-white/10 bg-white/10 p-4 text-white">
				<Sparkles class="size-5 text-[var(--color-lime)]" />
				<p class="mt-3 text-2xl font-bold">Real-time</p>
				<p class="mt-1 text-sm text-white/65">Customer signal updates</p>
			</div>
		</div>
	</div>
</div>
