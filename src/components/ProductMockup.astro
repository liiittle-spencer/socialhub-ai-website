---
import { Bot, ChartNoAxesCombined, Database, Sparkles } from '@lucide/astro';
---

<div class="mockup-grid relative overflow-hidden rounded-lg border border-white/14 bg-white/8 p-3 shadow-[var(--shadow-soft)] sm:p-4">
	<div class="rounded-lg border border-white/14 bg-[var(--color-navy)] p-3 sm:p-4">
		<div class="flex items-center justify-between gap-4 border-b border-white/10 pb-4">
			<div>
				<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-lime)] sm:text-xs">Command Center</p>
				<h2 class="mt-2 text-lg font-bold text-white sm:text-xl">Customer Intelligence</h2>
			</div>
			<div class="rounded-md bg-white/10 px-3 py-2 text-xs font-semibold text-white">Live</div>
		</div>

		<div class="mt-4 grid gap-3 lg:grid-cols-[0.95fr_1.05fr]">
			<section class="rounded-md border border-white/10 bg-white p-3 text-[var(--color-ink)] sm:p-4">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-green-dark)] sm:text-xs">Customer 360</p>
						<h3 class="mt-2 text-base font-bold sm:text-lg">High-value members</h3>
					</div>
					<Database class="size-5 text-[var(--color-green)]" />
				</div>
				<div class="mt-4 space-y-3">
					<div class="h-3 w-full rounded-full bg-[#eef4f1]">
						<div class="h-3 w-[76%] rounded-full bg-[var(--color-green)]"></div>
					</div>
					<div class="grid grid-cols-3 gap-2 text-center sm:gap-3">
						<div class="rounded-md bg-[var(--color-soft)] p-2 sm:p-3">
							<p class="text-base font-bold sm:text-lg">42K</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">Members</p>
						</div>
						<div class="rounded-md bg-[var(--color-soft)] p-2 sm:p-3">
							<p class="text-base font-bold sm:text-lg">18%</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">At risk</p>
						</div>
						<div class="rounded-md bg-[var(--color-soft)] p-2 sm:p-3">
							<p class="text-base font-bold sm:text-lg">3.4x</p>
							<p class="mt-1 text-[11px] text-[var(--color-muted)]">LTV</p>
						</div>
					</div>
				</div>
			</section>

			<section class="rounded-md border border-white/10 bg-white p-3 text-[var(--color-ink)] sm:p-4">
				<div class="flex items-center gap-3">
					<span class="grid size-9 place-items-center rounded-md bg-[var(--color-mint)]">
						<Sparkles class="size-5 text-[var(--color-green-dark)]" />
					</span>
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-green-dark)]">AI insight</p>
						<h3 class="font-bold">Next-best action</h3>
					</div>
				</div>
				<p class="mt-4 text-sm leading-6 text-[var(--color-muted)]">
					Weekend buyers with declining visits respond best to tier upgrade reminders and local inventory prompts.
				</p>
				<div class="mt-4 hidden flex-wrap gap-2 sm:flex">
					<span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">Loyalty</span>
					<span class="rounded-full bg-[#f2f4f7] px-3 py-1 text-xs font-bold text-[#475467]">Campaign</span>
					<span class="rounded-full bg-[#f2f4f7] px-3 py-1 text-xs font-bold text-[#475467]">Segment</span>
				</div>
			</section>
		</div>

		<div class="mt-3 grid gap-3 sm:grid-cols-3">
			<div class="rounded-md border border-white/10 bg-white/10 p-3 text-white sm:p-4">
				<ChartNoAxesCombined class="size-5 text-[var(--color-lime)]" />
				<p class="mt-2 text-lg font-bold sm:mt-3 sm:text-2xl">+24%</p>
				<p class="mt-1 text-sm text-white/65">Campaign conversion</p>
			</div>
			<div class="rounded-md border border-white/10 bg-white/10 p-3 text-white sm:p-4">
				<Bot class="size-5 text-[var(--color-lime)]" />
				<p class="mt-2 text-lg font-bold sm:mt-3 sm:text-2xl">6</p>
				<p class="mt-1 text-sm text-white/65">AI agents active</p>
			</div>
			<div class="hidden rounded-md border border-white/10 bg-white/10 p-3 text-white sm:block sm:p-4">
				<Sparkles class="size-5 text-[var(--color-lime)]" />
				<p class="mt-2 text-lg font-bold sm:mt-3 sm:text-2xl">Real-time</p>
				<p class="mt-1 text-sm text-white/65">Customer signal updates</p>
			</div>
		</div>
	</div>
</div>
