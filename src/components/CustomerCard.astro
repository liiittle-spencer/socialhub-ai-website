---
import { ArrowRight } from '@lucide/astro';
import { contentSlug } from '../data/routing';

type Props = {
	story: {
		id: string;
		data: {
			customerName: string;
			title: string;
			summary: string;
			industry: string;
			logoText?: string;
			results?: { value: string; label: string }[];
		};
	};
};

const { story } = Astro.props;
const slug = contentSlug(story.id);
const metrics = story.data.results?.slice(0, 2) ?? [];
---

<article class="surface-card flex h-full flex-col rounded-lg p-5 sm:p-6">
	<div class="flex items-center justify-between gap-4">
		<div class="grid h-13 min-w-32 place-items-center rounded-md bg-[var(--color-soft)] px-4 text-sm font-black text-[var(--color-navy)]">
			{story.data.logoText || story.data.customerName}
		</div>
		<span class="rounded-full bg-[var(--color-mint)] px-3 py-1 text-xs font-bold text-[var(--color-green-dark)]">
			{story.data.industry}
		</span>
	</div>
	<h2 class="mt-6 text-lg font-bold tracking-[0] text-[var(--color-ink)]">{story.data.title}</h2>
	<p class="mt-3 flex-1 text-sm leading-6 text-[var(--color-muted)]">{story.data.summary}</p>
	{metrics.length > 0 && (
		<div class="mt-6 grid grid-cols-2 gap-3">
			{metrics.map((metric) => (
				<div class="rounded-md bg-[var(--color-soft)] p-3">
					<p class="text-lg font-bold text-[var(--color-navy)]">{metric.value}</p>
					<p class="mt-1 text-xs leading-5 text-[var(--color-muted)]">{metric.label}</p>
				</div>
			))}
		</div>
	)}
	<a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-green-dark)]" href={`/customers/${slug}/`}>
		Read story
		<ArrowRight class="size-4" />
	</a>
</article>
